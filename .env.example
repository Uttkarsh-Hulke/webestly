# WebEstly Environment Configuration
# Copy this file to .env or .env.local and populate with your production credentials

# Official public inquiries email address (e.g., hello@webestly.com)
VITE_CONTACT_EMAIL=

# Official WhatsApp Business phone number in international format without '+' or spaces (e.g., 919823012345)
VITE_WHATSAPP_NUMBER=

# Formatted telephone number for display in headers and contact page (e.g., +91 98230 12345)
VITE_PHONE_DISPLAY=

# Google Apps Script Web App URL for Google Sheets enquiry integration
# Used by local Vite proxy and set as an encrypted environment secret in Cloudflare Pages
# See scripts/google-apps-script.js for setup instructions
APPS_SCRIPT_URL=

# Optional direct API endpoint override (defaults to same-origin /api/enquiries)
VITE_CONTACT_API_ENDPOINT=

# Canonical production website URL (e.g., https://webestly.com)
VITE_SITE_URL=https://webestly.com
